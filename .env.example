# Заявки. Пока переменные пустые, форма в production ответит ошибкой
# и предложит позвонить. В development заявка показывается как принятая.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
LEAD_EMAIL_FROM=
