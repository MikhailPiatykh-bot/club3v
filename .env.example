# Публичный адрес сайта. Нужен для canonical, Open Graph и sitemap.
NEXT_PUBLIC_SITE_URL=https://club3v.ru

# Код подтверждения из Яндекс Вебмастера. Пока пусто — мета-тег не выводится.
